# PostgreSQL (local con Docker o Neon). SQLite no funciona en Vercel.
# En Neon/Vercel usa la URL con -pooler para el runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/morahueso?schema=public"

JWT_SECRET="cambia-este-secreto"
NEXT_PUBLIC_TAX_RATE="0.16"

# URL pública de la app (HTTPS en preview/prod). Local: http://localhost:3000
# Preview mvp2: https://mora-hueso-git-mvp2-morahueso.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Access Token de Mercado Pago. Checkout Pro usa APP_USR- tanto en prueba como en producción.
# Local/preview: credenciales de prueba. Producción: credenciales de producción.
MERCADOPAGO_ACCESS_TOKEN=""

# Firma del webhook (Tus integraciones → Webhooks → clave secreta).
# En preview/prod es obligatoria si el panel tiene secreto configurado.
# Local: déjala vacía (localhost no recibe webhooks).
# Endpoint: {NEXT_PUBLIC_APP_URL}/api/mercadopago/webhook
# MERCADOPAGO_WEBHOOK_SECRET=""

# Si no hay token, permite /pago/demo para desarrollo local
ALLOW_DEMO_PAYMENTS="true"

# Vercel Blob (Storage → mora-hueso-blob). En producción Vercel lo inyecta al
# conectar el store. En local, copia BLOB_READ_WRITE_TOKEN a .env.local.
# BLOB_READ_WRITE_TOKEN=""
