# PostgreSQL (local con Docker o Neon). SQLite no funciona en Vercel.
# En Neon/Vercel usa la URL con -pooler para el runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/morahueso?schema=public"

JWT_SECRET="cambia-este-secreto"
NEXT_PUBLIC_TAX_RATE="0.16"

# URL pública de la app (HTTPS en producción, p. ej. https://mora-hueso.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Access Token de Mercado Pago (TEST o PROD)
MERCADOPAGO_ACCESS_TOKEN=""

# Si no hay token, permite /pago/demo para desarrollo local
ALLOW_DEMO_PAYMENTS="true"
